@page
@model ZAAL_SQL.Pages.Series.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete page</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            <p>Title</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Title)
        </dd>
        <dt class="col-sm-2">
            <p>Release year</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Year)
        </dd>
        <dt class="col-sm-2">
            <p>Genre</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Genre)
        </dd>
        <dt class="col-sm-2">
            <p>Seasons</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.TotalSeasons)
        </dd>
        <dt class="col-sm-2">
            <p>Plot</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Plot)
        </dd>
        <dt class="col-sm-2">
            <p>Rating</p>
        </dt>
        <dd class="col-sm-10">
            <p> @Html.DisplayFor(model => model.Serie.ImdbRating)/10</p>
        </dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Serie.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
