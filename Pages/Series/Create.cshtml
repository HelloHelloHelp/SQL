@page
@model ZAAL_SQL.Pages.Series.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Add page</h1>
<p>Add a new serie here</p>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <p>Title</p>
                <input asp-for="Serie.Titel" class="form-control" />
                <span asp-validation-for="Serie.Titel" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <p>Release date</p>
                <input asp-for="Serie.Date" class="form-control" />
                <span asp-validation-for="Serie.Date" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <p>Genre</p>
                <input asp-for="Serie.Genre" class="form-control" />
                <span asp-validation-for="Serie.Genre" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <p>Restricting age</p>
                <input asp-for="Serie.Restricting_age" class="form-control" />
                <span asp-validation-for="Serie.Restricting_age" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <p>Seasons</p>
                <input asp-for="Serie.Seasons" class="form-control" />
                <span asp-validation-for="Serie.Seasons" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <label asp-for="Serie.Rating" class="control-label"></label>
                <input asp-for="Serie.Rating" class="form-control" />
                <span asp-validation-for="Serie.Rating" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
