@page
@model MoviesAPI.Pages.Series.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>New serie</h1>
@if (Model.errorMessage.Length > 0)
{
    <div class="alert alert-warning alert-dismissible fade show" role='alert'>
        <strong>@Model.errorMessage</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<hr />

<form method="post">
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="Title" value="@Model.serie.Title">
        </div>
    </div>
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="Year" value="@Model.serie.Year">
        </div>
    </div>
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="Genre" value="@Model.serie.Genre">
        </div>
    </div>
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="Restricting_age" value="@Model.serie.Restricting_age">
        </div>
    </div>
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="TotalSeasons" value="@Model.serie.TotalSeasons">
        </div>
    </div>
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="ImdbRating" value="@Model.serie.ImdbRating">
        </div>
    </div>
    <div class="row mb-3">
        <div class="offset-sm-3 col-sm-3 d-grid">
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
        <div class="col-sm-3 d-grid">
            <a class="btn-primary btn-outline-primary" href="/" role="button">Cancel</a>
        </div>
    </div>
</form>


<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
