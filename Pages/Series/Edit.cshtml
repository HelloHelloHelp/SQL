@page
@model ZAAL_SQL.Pages.Series.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit page</h1>
<p>Edit the details of your chosen serie</p>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Serie.ID" />
            <div class="form-group">
                <p>Title</p>
                <input asp-for="Serie.Title" class="form-control" />
                <span asp-validation-for="Serie.Title" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <p>Release date</p>
                <input asp-for="Serie.Year" class="form-control" />
                <span asp-validation-for="Serie.Year" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <p>Genre</p>
                <input asp-for="Serie.Genre" class="form-control" />
                <span asp-validation-for="Serie.Genre" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <p>Seasons</p>
                <input asp-for="Serie.TotalSeasons" class="form-control" />
                <span asp-validation-for="Serie.TotalSeasons" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <p>Rating</p>
                <input asp-for="Serie.ImdbRating" class="form-control" />
                <span asp-validation-for="Serie.ImdbRating" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
