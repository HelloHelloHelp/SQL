@page
@model MoviesAPI.Pages.Series.IndexModel

@{
}

<br>
<h2>List of series</h2>
<a class='btn-primary btn-primary btn-sm' href="Movies/Create">New serie</a>
<table class="table">
	<thead>
		<tr>
			<th>ID</th>
			<th>Titel</th>
			<th>Imdb ID</th>
			<th>Director</th>
			<th>Date</th>
			<th>Genre</th>
			<th>Seasons</th>
			<th>Rated</th>
			<th>Language</th>
			<th>Duration</th>
			<th>Plot</th>
			<th>Poster</th>
			<th>Watched</th>
			<th>Rating</th>
		</tr>
	</thead>
	<tbody>

		@foreach (var serie in Model.series)
		{
			<tr>
				<td>@serie.ID</td>
				<td>@serie.Title</td>
				<td>@serie.ImdbID</td>
				<td>@serie.Director</td>
				<td>@serie.Year</td>
				<td>@serie.Genre</td>
				<th>@serie.TotalSeasons</th>
				<td>@serie.Rated</td>
				<td>@serie.Language</td>
				<th>@serie.Runtime</th>
				<td>@serie.Plot</td>
				<td>
					@if (serie.Poster != null)
					{
						<img src="@serie.Poster" alt="Poster" style="width:200px;" />
					}
				</td>
				<td>@serie.Watched</td>
				<td>@serie.ImdbRating</td>

				<td>
					<a class='btn-primary btn-primary btn-sm' href="/Movies/Edit?id=@serie.ID">Edit</a>
					<a class='btn-primary btn-primary btn-sm' href="/Movies/Delete?id=@serie.ID">Delete</a>
				</td>
			</tr>
		}
	</tbody>
</table>




