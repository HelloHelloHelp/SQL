@page
@model ZAAL_SQL.Pages.Series.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details page</h1>
<p>See the details of your chosen serie</p>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            <p>Title</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Title)
        </dd>
        <dt class="col-sm-2">
            <p>Release year</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Year)
        </dd>
        <dt class="col-sm-2">
            <p>Genre</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Genre)
        </dd>
        <dt class="col-sm-2">
            <p>Seasons</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.TotalSeasons)
        </dd>
        <dt class="col-sm-2">
            <p>Poster</p>
        </dt>
        </dt>
        <dd class="col-sm-10">
            @if (Model.Serie.Poster != null)
            {
                <img src="data:image/jpeg;base64,@Convert.ToBase64String(Model.Serie.Poster)" style="width:120px; height:auto;" />
            }
            else
            {
                <span>No poster</span>
            }
        </dd>

        <dt class="col-sm-2">
            <p>Rating</p>
        </dt>
        <dd class="col-sm-10">
            <p>  @Html.DisplayFor(model => model.Serie.ImdbRating)/10</p>
        </dd>


    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Serie.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
