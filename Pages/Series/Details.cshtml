@page
@model ZAAL_SQL.Pages.Series.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details page</h1>
<p>See the details of your chosen serie</p>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            <p>Title</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Titel)
        </dd>
        <dt class="col-sm-2">
            <p>Release date</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Date)
        </dd>
        <dt class="col-sm-2">
            <p>Genre</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Genre)
        </dd>
        <dt class="col-sm-2">
            <p>Restricting age</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Restricting_age)
        </dd>
        <dt class="col-sm-2">
            <p>Seasons</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Seasons)
        </dd>
        <dt class="col-sm-2">
            <p>Platform</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Serie.Platform)
        </dd>
        <dt class="col-sm-2">
            <p>Rating</p>
        </dt>
        <dd class="col-sm-10">
            <p>  @Html.DisplayFor(model => model.Serie.Rating)/10</p>
        </dd>


    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Serie.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
