@page
@model ZAAL_SQL.Pages.LFMAS.LFS.IndexModel

@{
    ViewData["Title"] = "Recommends series";
}
@if (TempData["Message"] != null)
{
    <div id="alertMessage" class="alert alert-success">
        @TempData["Message"]
    </div>

    <script>
        setTimeout(function () {
            var msg = document.getElementById("alertMessage");
            if (msg) {
                msg.style.display = "none";
            }
        }, 6000);
    </script>
}
<h1>@ViewData["Title"]</h1>
<p>
    <a class='btn btn-primary brn-sm' href='/LFMAS/Index'>Back</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Title
            </th>
            <th>
                Release date
            </th>
            <th>
                Genre
            </th>
            <th>
                Restricting age
            </th>
            <th>
                Seasons
            </th>
            <th>
                Poster
            </th>
            <th>
                Rating
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Series)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => item.Titel)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Restricting_age)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Seasons)
                </td>
                <td>
                    <p>@Html.DisplayFor(modelItem => item.Poster)</p>
                </td>

                <td>
                    <p>/10</p>
                </td>
                <td>
                    <form method="post" asp-page-handler="Add">
                        <button type="submit" asp-page-handler="Add" asp-route-id="@item.ID">Add</button>
                    </form>
                </td>
             
            </tr>
        }
    </tbody>
</table>
