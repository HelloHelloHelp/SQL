@page
@model MoviesAPI.Pages.LFMAS.IndexModel
@{
}
<h2>List of movies</h2>
<table class="table">
	<thead>
		<tr>
			<th>ID</th>
			<th>Title</th>
			<th>Year</th>
			<th>Genre</th>
			<th>Restricting age</th>
			<th>Poster</th>
			<th>imdbRating</th>
		</tr>
	</thead>
	<tbody>

		@foreach (var movie in Model.Movies)
		{
			<tr>
				<td>@movie.ID</td>
				<td>@movie.Title</td>
				<td>@movie.Year</td>
				<td>@movie.Genre</td>
				<td>@movie.Restricting_age</td>
				<td>
					@if (movie.Poster != null)
					{
						<img src="@movie.Poster" alt="Poster" style="width:200px;" />
					}
				</td>
				<td>@movie.ImdbRating</td>
			</tr>

		
		}

	</tbody>
</table>

<h2>List of movies</h2>
<table class="table">
	<thead>
		<tr>
			<th>ID</th>
			<th>Titel</th>
			<th>Date</th>
			<th>Genre</th>
			<th>Restricting age</th>
			<th>Poster</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var serie in Model.Series)
		{
			<tr>
			<td>@serie.ID</td>
				<td>@serie.Titel</td>
				<td>@serie.Date</td>
				<td>@serie.Genre</td>
				<td>@serie.Restricting_age</td>
				<td>@serie.Poster</td>
		       <th>@serie.Rating</th>
			</tr>
		}
	</tbody>