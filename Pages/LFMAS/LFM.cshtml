@page
@model ZAAL_SQL.Pages.LFMAS.LFM.IndexModel
@{
    ViewData["Title"] = "Recommends movies";
}

<h1>@ViewData["Title"]</h1>
<p>
    <a class='btn btn-primary brn-sm' href='/LFMAS/Index'>Back</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
             Title
            </th>
            <th>
            Release date
            </th>
            <th>
             Genre
            </th>
            <th>
                Restricting age
            </th>
            <th>
                Platform
            </th>
			<th>
                Rating
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.movies)
        {
            <tr>

                <td>
                    @Html.DisplayFor(modelItem => item.Titel)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Date)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Restricting_age)
                </td>
                <td>
                    <p>@Html.DisplayFor(modelItem => item.Platform)</p>
                </td>

                <td>
                    <p>/10</p>
                </td>
                <td>
                    <a class="btn btn-primary btn-sm" onclick="alert('Added to your movie list!');">
                        Add
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
