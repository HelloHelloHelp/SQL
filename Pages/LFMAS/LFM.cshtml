@page
@model ZAAL_SQL.Pages.LFMAS.LFM.IndexModel
@{
    ViewData["Title"] = "Recommends movies";
}
@if (TempData["Message"] != null)
{
    <div id="alertMessage" class="alert alert-success">
        @TempData["Message"]
    </div>

    <script>
        setTimeout(function () {
            var msg = document.getElementById("alertMessage");
            if (msg) {
                msg.style.display = "none";
            }
        }, 6000); 
    </script>
}


<h1>@ViewData["Title"]</h1>
<p>
    <a class='btn btn-primary brn-sm' href='/LFMAS/Index'>Back</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                Imdb ID
            </th>
            <th>
                Director
            </th>
            <th>
             Title
            </th>
            <th>
             Release year
            </th>
            <th>
             Genre
            </th>
            <th>
               Plot
            </th>
            <th>
                Rated
            </th>
            <th>
                Language
            </th>
            <th>
                Duration
            </th>
            <th>   
                Poster
            </th>
			<th>
                Rating
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.movies)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ImdbID)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Director)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Year)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Genre)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Plot)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Rated)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Language)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Runtime)
                </td>
                <td>
                    @if (item.Poster != null)
                    {
                        <img src="data:image/jpeg;base64,@Convert.ToBase64String(item.Poster)"
                             style="width:120px; height:auto;" />
                    }
                    else
                    {
                        <span>No poster</span>
                    }

                </td>
                <td>
                    <p>@Html.DisplayFor(modelItem => item.ImdbRating)/10</p>
                </td>
                <td>
                <form method="post" asp-page-handler="Add">
                 <button type="submit" asp-page-handler="Add" asp-route-id="@item.ID">Add</button>
                </form>
	                </td>
            </tr>
        }
       
    </tbody>
</table>

