@page
@model ZAAL_SQL.Pages.Movies.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details page</h1>
<p>The details of your chosen serie</p>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            <p>Title</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Title)
        </dd>
        <dt class="col-sm-2">
            <p>Release year</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Year)
        </dd>
        <dt class="col-sm-2">
            <p>Genre</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Genre)
        </dd>
        <dt class="col-sm-2">
            <p>Plot</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Plot)
        </dd>

        <dt class="col-sm-2">
            <p>Rating</p>
        </dt>
        <dd class="col-sm-10">
            <p>  @Html.DisplayFor(model => model.Movie.ImdbRating)/10</p>
        </dd>


    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Movie.ID">Edit</a> |
    <a asp-page="./Delete" asp-route-id="@Model.Movie.ID">Delete</a> |
    <a asp-page="./Index">Back to List</a>
</div>
