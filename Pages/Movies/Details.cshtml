@page
@model ZAAL_SQL.Pages.Movies.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details page</h1>
<p>See the details of your chosen movie</p>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            <p>Title</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Title)
        </dd>
        <dt class="col-sm-2">
            <p>Release year</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Year)
        </dd>
        <dt class="col-sm-2">
            <p>Genre</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Genre)
        </dd>
        <dt class="col-sm-2">
            <p>Restricting age</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Restricting_age)
        </dd>
        <dt class="col-sm-2">
            <p>Platform</p>
        </dt>
        <dt class="col-sm-2">
            <p>Rating</p>
        </dt>
        <dd class="col-sm-10">
            <p>  @Html.DisplayFor(model => model.Movie.ImdbRating)/10</p>
        </dd>
        
      
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Movie.ID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
