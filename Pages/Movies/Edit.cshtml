@page
@model MoviesAPI.Pages.Movies.EditModel

@{
    ViewData["Title"] = "Edit";
}


<h1>Edit movie</h1>
@if (Model.errorMessage.Length > 0)
{
    <div class="alert alert-warning alert-dismissible fade show" role='alert'>
        <strong>@Model.errorMessage</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<hr />

<form method="post">
    <input type="hidden" name="ID" value="@Model.movie.ID">
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="Titel" value="@Model.movie.Titel">
        </div>
    </div>
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="Date" value="@Model.movie.Date">
        </div>
    </div>
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="Genre" value="@Model.movie.Genre">
        </div>
    </div>
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="Restricting_age" value="@Model.movie.Restricting_age">
        </div>
    </div>
    <div class="col-mb-3">
        <label class="col-sm-3 col-form-label">Titel</label>
        <div class="col-sm-6">
            <input type="text" class="form-control" name="Rating" value="@Model.movie.Rating">
        </div>
    </div>
    <div class="row mb-3">
        <div class="offset-sm-3 col-sm-3 d-grid">
            <button type="submit" class="btn btn-primary">Submit</button>
        </div>
        <div class="col-sm-3 d-grid">
            <a class="btn-primary btn-outline-primary" href="/" role="button">Cancel</a>
        </div>
    </div>
</form>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
