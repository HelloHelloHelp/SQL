@page
@model MoviesAPI.Pages.Movies.IndexModel

@{
}

<h2>List of movies</h2>
<a class='btn-primary btn-primary btn-sm' href="Movies/Create">New movie</a>
<table class="table">
	<thead>
		<tr>
			<th>ID</th>
			<th>Title</th>
			<th>Year</th>
			<th>Genre</th>
			<th>Plot</th>
			<th>Duration</th>
			<th>Poster</th>
			<th>Watched</th>
			<th>Rating</th>
		</tr>
	</thead>
	<tbody>

		@foreach (var movie in Model.movies)
		{
			<tr>
				<td>@movie.ID</td>
				<td>@movie.Title</td>
				<td>@movie.Year</td>
				<td>@movie.Genre</td>
				<td>@movie.Plot</td>
				<td>@movie.Runtime</td>
				<td>@movie.Poster</td>
				<th>@movie.ImdbRating</th>

				<td>
					<a class='btn-primary btn-primary btn-sm' href="/Movies/Edit?id=@movie.ID">Edit</a>
					<a class='btn-primary btn-primary btn-sm' href="/Movies/Delete?id=@movie.ID">Delete</a>
</td>
				</tr>
		}
		</tbody>
	</table>
				
		
	

