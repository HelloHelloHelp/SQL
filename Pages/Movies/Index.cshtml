@page
@model ZAAL_SQL.Pages.Movies.IndexModel

@{
    ViewData["Title"] = "Movies";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a class='btn btn-primary brn-sm' href='/Movies/Create'>Add a movie</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
             Title
            </th>
            <th>
            Release date
            </th>
            <th>
             Genre
            </th>
            <th>
                Restricting age
            </th>
            <th>
                Poster
            </th>
            <th>
                Watched
            </th>
			<th>
                Rating
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Movie) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Titel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Date)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Genre)
            </td>
            <td>
             @Html.DisplayFor(modelItem => item.Restricting_age)
            </td>
                <td>
                    <p>@Html.DisplayFor(modelItem => item.Poster)</p>
                </td>
                <td>
                    <form method="post" asp-page-handler="SetWatched" class="m-0 p-0">
                        <input type="hidden" name="id" value="@item.ID" />
                        <select name="watched" class="form-select" onchange="this.form.submit()">
                            @{
                                var val = item.Watched;
                                if (string.IsNullOrEmpty(val))
                                {
                                    <option value="" selected>----</option>
                                    ;
                                }
                                else
                                {
                                    <option value="">----</option>
                                    ;
                                }

                                if (val == "havent")
                                {
                                    <option value="havent" selected>havent</option>
                                    ;
                                }
                                else
                                {
                                    <option value="havent">havent</option>
                                    ;
                                }

                                if (val == "done")
                                {
                                    <option value="done" selected>done</option>
                                    ;
                                }
                                else
                                {
                                    <option value="done">done</option>
                                    ;
                                }

                                if (val == "started")
                                {
                                    <option value="started" selected>started</option>
                                    ;
                                }
                                else
                                {
                                    <option value="started">started</option>
                                    ;
                                }
                            }
                        </select>
                    </form>
                </td>
                <td>
                 <p>@Html.DisplayFor(modelItem => item.Rating) /10</p>
				</td>
            <td>
                    <a class='btn btn-primary brn-sm' href='/Movies/Edit?id=@item.ID'>Edit</a>
                    <a class='btn btn-primary brn-sm' href='/Movies/Details?id=@item.ID'>Details</a>
                    <a class='btn btn-primary brn-sm' href='/Movies/Delete?id=@item.ID'>Delete</a>
                  
				</td>
        </tr>
}
    </tbody>
</table>
