@page
@model MoviesAPI.Pages.Movies.IndexModel

@{
}

<h2>List of movies</h2>
<a class='btn-primary btn-primary btn-sm' href="Movies/Create">New movie</a>
<table class="table">
	<thead>
		<tr>
			<th>ID</th>
			<th>Titel</th>
			<th>Date</th>
			<th>Genre</th>
			<th>Restricting age</th>
			<th>Platform</th>
			<th>Watched</th>
			<th>Rating</th>
		</tr>
	</thead>
	<tbody>

		@foreach (var movie in Model.ListMovies)
		{
			<tr>
				<td>@movie.ID</td>
				<td>@movie.Titel</td>
				<td>@movie.Date</td>
				<td>@movie.Genre</td>
				<td>@movie.Restricting_age</td>
				<td>@movie.Platform</td>
				<td>@movie.Watched</td>
				<td>@movie.Rating</td>

				<td>
					<a class='btn-primary btn-primary btn-sm' href="/Movies/Edit?id=@movie.ID">Edit</a>
					<a class='btn-primary btn-primary btn-sm' href="/Movies/Delete?id=@movie.ID">Delete</a>
</td>
				</tr>
		}
		</tbody>
	</table>
				
		
	

