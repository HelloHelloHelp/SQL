@page
@model ZAAL_SQL.Pages.Movies.IndexModel

@{
    ViewData["Title"] = "Movies";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a class='btn btn-primary brn-sm' href='/Movies/Create'>Add a movie</a>
</p>
<div class="row g-3">
    @foreach (var item in Model.Movie)
    {
        <div class="col-6 col-sm-4 col-md-3 col-lg-2 text-center">

            @if (item.Poster != null)
            {
                <a href="/Movies/Details?id=@item.ID">
                    <img src="data:image/jpeg;base64,@Convert.ToBase64String(item.Poster)"
                         class="img-fluid mb-2"
                         style="max-width:120px;" />
                </a>
            }
                else
        {
        <div>No poster</div>
        <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a>
        <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
        }

            <form method="post" asp-page-handler="SetWatched">
                <input type="hidden" name="id" value="@item.ID" />
                <select name="watched"
                        class="form-select form-select-sm"
                        onchange="this.form.submit()">
                    <option value="" selected="@string.IsNullOrEmpty(item.Watched)">----</option>
                    <option value="havent" selected="@(item.Watched == "havent")">havent</option>
                    <option value="started" selected="@(item.Watched == "started")">started</option>
                    <option value="done" selected="@(item.Watched == "done")">done</option>
                </select>
            </form>
        </div>
    }
</div>