@page
@model ZAAL_SQL.Pages.Movies.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete page</h1>

<p>Are you sure you want to delete this?</p>
<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            <p>Imdb ID</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.ImdbID)
        </dd>
        <dt class="col-sm-2">
            <p>Director</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Director)
        </dd>
        <dt class="col-sm-2">
            <p>Title</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Title)
        </dd>
        <dt class="col-sm-2">
            <p>Release year</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Year)
        </dd>
        <dt class="col-sm-2">
            <p>Genre</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Genre)
        </dd>
        <dt class="col-sm-2">
            <p>Plot</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Plot)
        </dd>
        <dt class="col-sm-2">
            <p>Rated</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Rated)
        </dd>
        <dt class="col-sm-2">
            <p>Language</p>
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Movie.Language)
        </dd>
        <dt class="col-sm-2">
            <p> Duration</p>
		</dt>
        <dd class="col-sm-10">
			@Html.DisplayFor(model => model.Movie.Runtime)
        <dt class="col-sm-2">
            <p>Rating</p>
        </dt>
        <dd class="col-sm-10">
          <p> @Html.DisplayFor(model => model.Movie.ImdbRating)/10</p>
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="Movie.ID" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
